+def select_front_and_back(expiries: list[date], front_dte: int, back_months: int) -> tuple[date, date]:
+    et_today = datetime.now(pytz.timezone("America/New_York")).date()
+    front = next((expiry for expiry in expiries if (expiry - et_today).days >= front_dte), None)
+    if front is None:
+        raise RuntimeError(f"no front expiry >= {front_dte}d")
+    try:
+        front_idx = expiries.index(front)
+    except ValueError as exc:
+        raise RuntimeError("front expiry missing from expiry list") from exc
+    back_idx = front_idx + back_months
+    if back_idx >= len(expiries):
+        raise RuntimeError(f"no back expiry {back_months} months after {front}")
+    return front, expiries[back_idx]
 
 
